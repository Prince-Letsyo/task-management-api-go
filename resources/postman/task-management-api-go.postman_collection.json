      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"first_name\":\"Alice\",\"last_name\":\"Doe\",\"username\":\"alice\",\"email\":\"alice@example.com\",\"password_one\":\"CorrectHorseBatteryStaple1!\",\"password_two\":\"CorrectHorseBatteryStaple1!\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/sign-up",
